{
  "name": "tokenmon",
  "version": "0.0.0",
  "private": true,
  "description": "Tokenmon — 本地桌宠:可视化 Claude Code 用量,消耗 token 喂养 Monster(macOS MVP)",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @tokenmon/desktop dev",
    "build": "pnpm --filter @tokenmon/desktop build",
    "rebuild": "pnpm --filter @tokenmon/desktop rebuild",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @tokenmon/desktop test",
    "dist": "pnpm --filter @tokenmon/desktop dist"
  }
}
